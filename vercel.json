{
  "buildCommand": "npm run build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/subscription-sync",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/daily-push",
      "schedule": "*/30 * * * *"
    }
  ]
}
