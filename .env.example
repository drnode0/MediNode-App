NOTION_TOKEN=your_notion_integration_token
NOTION_MEDICAL_DB_ID=your_medical_db_id
NOTION_REFERENCE_DB_ID=your_reference_db_id
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_SEARCH_KEY=your_algolia_search_key
ALGOLIA_ADMIN_KEY=your_algolia_admin_key
ALGOLIA_INDEX=medical_knowledge
NEXT_PUBLIC_ALGOLIA_APP_ID=your_algolia_app_id
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=your_algolia_search_key
NEXT_PUBLIC_ALGOLIA_INDEX=medical_knowledge

# --- Supabase（ログイン基盤・フェーズ1） ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
# サーバー専用（service_role / secret）。絶対に公開・コミットしない。
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_or_service_role_key

# --- 無料解放（comp / 招待コード） ---
# 用途①: 自分専用。ここに列挙したログインメール（カンマ区切り）は
#         DBの契約状態に関わらず常時プレミアム有効になる。UIは不要・完全に不可視。
COMP_ADMIN_EMAILS=you@example.com
# 用途②: 招待コード（カンマ区切り）。既存のトライアル入力欄に入れると
#         ログイン中ユーザーへ無期限comp（subscriptions.plan=comp）を付与する。
#         秘密の値にすること。空なら招待コード機能は無効。
COMP_INVITE_CODES=your_secret_invite_code
