NOTION_TOKEN=your_notion_integration_token
NOTION_MEDICAL_DB_ID=your_medical_db_id
NOTION_REFERENCE_DB_ID=your_reference_db_id
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_SEARCH_KEY=your_algolia_search_key
ALGOLIA_ADMIN_KEY=your_algolia_admin_key
ALGOLIA_INDEX=medical_knowledge
NEXT_PUBLIC_ALGOLIA_APP_ID=your_algolia_app_id
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=your_algolia_search_key
NEXT_PUBLIC_ALGOLIA_INDEX=medical_knowledge

# --- Supabase（ログイン基盤・フェーズ1） ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
# サーバー専用（service_role / secret）。絶対に公開・コミットしない。
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_or_service_role_key

# --- 無料解放（comp / 招待コード） ---
# 用途①: 自分専用。ここに列挙したログインメール（カンマ区切り）は
#         DBの契約状態に関わらず常時プレミアム有効になる。UIは不要・完全に不可視。
COMP_ADMIN_EMAILS=you@example.com
# 用途②: 招待コード（カンマ区切り）。既存のトライアル入力欄に入れると
#         ログイン中ユーザーへ無期限comp（subscriptions.plan=comp）を付与する。
#         秘密の値にすること。空なら招待コード機能は無効。
COMP_INVITE_CODES=your_secret_invite_code

# --- 期限付きトライアルコード（note特典など一般向け・カード不要・自動失効） ---
# 用途③: note有料記事の特典などに記載するコード（カンマ区切り）。既存のトライアル入力欄に入れると
#         ログイン中ユーザーへ期限付きトライアル（subscriptions.plan=trial, trial_ends_at=付与+日数）を付与。
#         サーバーが trial_ends_at を見て自動失効させるため、端末またぎでも期限が効く。
#         無期限comp（COMP_INVITE_CODES）とは別の環境変数で管理し、取り違えを防ぐこと。空なら無効。
TRIAL_CODES=your_secret_note_trial_code
# 期限付きトライアルの日数（未設定なら14）。
TRIAL_DAYS=14
# --- Stripe（サブスク決済） ---
# Secret Key。sk_test_ で始まるとアプリ全体が自動でテストモード表示（TestModeNotice）になり、
# sk_live_ に差し替えるとテスト表記が自動的に消える（コード変更は不要＝これがLive化の本体）。
STRIPE_SECRET_KEY=sk_test_xxx
# 月額プランの Price ID（Stripeダッシュボードで商品→価格を作成すると発行される）。
STRIPE_PRICE_ID=price_xxx
# Webhook署名検証用シークレット（Stripe→Webhook作成時に発行される whsec_...）。
# 登録イベント: checkout.session.completed / customer.subscription.updated /
#               customer.subscription.deleted / invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_xxx
# 解約用 Stripe カスタマーポータルのログインURL（任意）。未設定ならUIはメール問い合わせにフォールバック。
STRIPE_PORTAL_URL=
# クレジット登録（Stripe）の無料トライアル日数（未設定なら7）。
# note特典コード（TRIAL_DAYS=14）より短くして、note購入動線を相対的に優遇する意図。
STRIPE_TRIAL_DAYS=7

# --- サブスク会員に配布する Algolia（/api/premium/verify が使用） ---
# プレミアム購入者に short-lived な Secured Search Key を発行するための親キー。
# 通常検索用（ALGOLIA_*）とは別インデックス／別キーで運用する。
SUBSCRIPTION_ALGOLIA_APP_ID=your_subscription_algolia_app_id
SUBSCRIPTION_ALGOLIA_SEARCH_KEY=your_subscription_algolia_search_only_key
SUBSCRIPTION_ALGOLIA_INDEX=Medical Knowledge_DB（サブスク用）

# アプリのURL（Stripe Checkout の success_url / cancel_url に使用。本番は https://... のドメイン）。
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- comp付与の通知・棚卸し（すべて任意） ---
# 招待コードでcompが付与されたとき、オーナーへメール通知＆Notion台帳へ記録する。
# 未設定の経路は黙ってスキップされる（comp付与自体は常に成功）。
# メール通知（Resend HTTP API）:
RESEND_API_KEY=your_resend_api_key
COMP_NOTIFY_TO=owner@example.com
COMP_NOTIFY_FROM=noreply@your-verified-domain.com
# Notion台帳（棚卸し用。NOTION_TOKEN は既存のものを流用）:
COMP_NOTIFY_NOTION_DB=your_notion_comp_log_db_id
# 棚卸し・無効化API(/api/premium/comp)はCOMP_ADMIN_EMAILSのメールのみ許可。

# ── /admin デイリー・コマンドセンター（🗼今日の管理）──
# 未設定のソースは自動でリンクに劣化する（設定した順に点灯）。
# 受付DBの未対応件数を出すには、対象DBを Notion インテグレーション（SUBSCRIPTION_NOTION_TOKEN
# または NOTION_TOKEN のどちらか）に共有し、DB ID を設定する。VIEW は「🆕 未対応」ビューの ID（任意・
# 未設定ならDBトップにリンク）。
FEEDBACK_NOTION_DB=
FEEDBACK_NOTION_VIEW=
CQ_NOTION_DB=
CQ_NOTION_VIEW=
# 最新デプロイの Ready/Error を出す（任意）。Vercel の Account Settings → Tokens で発行。
# VERCEL_PROJECT_ID はプロジェクトの Settings → General、チーム所属なら VERCEL_TEAM_ID も。
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# 媒体別「貼るURL（utm付き）」コピー表を出すための紹介ページ(LP)のURL（任意）。未設定なら表は非表示。
NEXT_PUBLIC_LP_URL=

# ── メンテナンスモード（調整中画面）──
# 調整中画面の「Xで最新情報を見る」リンク先。未設定ならXボタンは非表示。
NEXT_PUBLIC_X_URL=
# オーナー素通し用の通行cookie署名鍵（任意）。未設定なら SUPABASE_SERVICE_ROLE_KEY を流用する。
# 専用鍵にする場合: openssl rand -base64 32 の値を入れる。
MAINTENANCE_BYPASS_SECRET=
